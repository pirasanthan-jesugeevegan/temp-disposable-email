{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "node"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "**/*.ts",
    "../../src/cypress.ts"
  ]
}
